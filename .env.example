[TEMPLATE]
# ── Monarch Media Platform environment ───────────────────────────────────────
# Copy to .env (or run ./scripts/setup.sh) and fill in real values.
# Never commit .env. Production secrets come from Infisical (SecretOps).

# ── General ─────────────────────────────────────────────────────────────────
TZ=UTC
# Admin account for the media UIs (Jellyfin + clipbucket)
MONARCH_USERNAME=change-me
MONARCH_PASSWORD=change-me
# Long random string — encrypts stored secrets/sessions (openssl rand -hex 32)
SECRET_ENCRYPTION_KEY=change-me

# ── Authentik (SSO / identity provider — Cerulean's Authentik) ──────────────
AUTHENTIK_BASE_URL=https://auth.monarch.innotel.us
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
# LDAP sync (optional): server + bind credentials for directory-based auth
AUTHENTIK_LDAP_SERVER=ldap://authentik
AUTHENTIK_LDAP_PORT=389
AUTHENTIK_LDAP_BASE_DN=dc=innotel,dc=us
AUTHENTIK_LDAP_ADMIN_GROUP=monarch-admins
AUTHENTIK_LDAP_BIND_GROUP=monarch-readers
AUTHENTIK_LDAP_BIND_USER=cn=monarch,ou=services,dc=innotel,dc=us
AUTHENTIK_LDAP_BIND_TOKEN=change-me
AUTHENTIK_LDAP_TOKEN=change-me

# ── OIDC (apps behind Authentik) ────────────────────────────────────────────
AUTH_OIDC_ISSUER=https://auth.monarch.innotel.us/application/o/monarch/
AUTH_OIDC_CLIENT_ID=monarch
AUTH_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
AUTH_OIDC_CLIENT_NAME=Monarch Media

# ── Media backends ──────────────────────────────────────────────────────────
JELLYFIN_URL=https://media.innotel.us
JELLYFIN_API_KEY=your-jellyfin-api-key
CLIPBUCKET_DOMAIN=clips.innotel.us
CLIPBUCKET_PORT=8080
# NextPVR ships one image per CPU arch; install-monarch.sh auto-picks it.
# NEXTPVR_IMAGE=nextpvr/nextpvr_amd64:latest
# Jellyfin is PINNED to the v12.0.0 build in docker-compose.yml - hotio tags
# this image only `latest`/`release`, which silently rolled 11 -> 12 and
# crash-looped on a data migration. Uncomment to move off the pin deliberately.
# JELLYFIN_IMAGE=ghcr.io/hotio/jellyfin@sha256:6f9599ab620b7c3414a1de42120dc08e7984baeaf6094125ce5c99b39878046a
SABNZBD_PORT=8085
# Live TV — M3U + EPG guide URLs
LIVETV_M3U_URL=
LIVETV_GUIDE_URL=

# ── AI / recommendations ────────────────────────────────────────────────────
# OmniRoute-compatible endpoint (single provider pool) or a direct OpenAI URL
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=change-me-omniroute-api-key
OPENAI_MODEL=auto

# ── Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ─────────────
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by the Monarch media login.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us

# ── Infisical (SecretOps) ───────────────────────────────────────────────────
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ORG=Innotel

# ── Magnate billing (RevenueOps — optional paid media seats) ────────────────
# MAGNATE_URL=https://magnate.innotel.us
# ENTITLEMENTS_API_TOKEN=  # must equal Magnate's ENTITLEMENTS_API_TOKEN