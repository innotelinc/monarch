# ── Monarch Media Platform environment ───────────────────────────────────────
# Copy to .env (or run ./scripts/setup.sh) and fill in real values.
# Never commit .env. Production secrets come from Cerulean Vault (SecretOps).

# ── General ─────────────────────────────────────────────────────────────────
TZ=UTC
# Admin account for the media UIs (Jellyfin + clipbucket)
MONARCH_USERNAME=change-me
MONARCH_PASSWORD=change-me
# Long random string (openssl rand -hex 32). This is Homarr's integration-secret
# key: it encrypts every integration secret Homarr stores, including the Jellyfin
# API key it holds. The key and /docker/appdata/homarr/appdata/db are one
# artifact — back them up together and restore them together.
#
# Never rotate it on a host whose Homarr DB already exists: the stored ciphertext
# was made with the old key, so every integration stops working (the dashboard
# stays up and the tiles just fail). If .env and the running container disagree,
# put .env back to the container's value — drift-check asserts they match.
SECRET_ENCRYPTION_KEY=change-me

# ── Authentik (SSO / identity provider — Cerulean's Authentik) ──────────────
AUTHENTIK_BASE_URL=https://auth.monarch.innotel.us
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
# LDAP outpost for the Jellyfin LDAP-Auth plugin (authentik-ldap service in
# docker-compose.yml): the outpost serves the Authentik directory so Jellyfin
# logins resolve against Authentik users. monarch-init provisions provider,
# outpost, bind user and groups (paid_users / jellyfin_admins) and pins both
# tokens below. Keep AUTHENTIK_LDAP_TOKEN equal to the AUTHENTIK_TOKEN the
# outpost container starts with; AUTHENTIK_LDAP_BIND_TOKEN is the password the
# Jellyfin plugin binds with.
#
# KEEP EACH VALUE ON A LINE OF ITS OWN — no trailing `# comment` after a token.
# Docker Compose strips an inline comment from an unquoted value, so the
# container starts with the truncated token while the value the outpost pinned
# in Authentik keeps the rest of the line. The two then never match and every
# Jellyfin sign-in fails: the outpost logs `403 Forbidden (Token invalid/
# expired)` and retries forever, and the bind itself dies with LDAP 49.
# If you rotate either token, update Authentik too (set the outpost token key,
# or the bind user's password) before recreating the container.
AUTHENTIK_LDAP_SERVER=authentik-ldap
AUTHENTIK_LDAP_PORT=3389
AUTHENTIK_LDAP_BASE_DN=dc=innotel,dc=us
AUTHENTIK_LDAP_ADMIN_GROUP=jellyfin_admins
AUTHENTIK_LDAP_BIND_GROUP=paid_users
AUTHENTIK_LDAP_BIND_USER=authentik-ldap
AUTHENTIK_LDAP_BIND_TOKEN=change-me
AUTHENTIK_LDAP_TOKEN=change-me

# ── OIDC (apps behind Authentik) ────────────────────────────────────────────
AUTH_OIDC_ISSUER=https://auth.monarch.innotel.us/application/o/monarch/
AUTH_OIDC_CLIENT_ID=monarch
AUTH_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
AUTH_OIDC_CLIENT_NAME='Monarch Media'

# ── Media backends ──────────────────────────────────────────────────────────
JELLYFIN_URL=https://media.innotel.us
JELLYFIN_API_KEY=your-jellyfin-api-key
CLIPBUCKET_DOMAIN=clips.innotel.us
CLIPBUCKET_PORT=8080
# NextPVR ships one image per CPU arch; install-monarch.sh auto-picks it.
# NEXTPVR_IMAGE=nextpvr/nextpvr_amd64:latest
# Jellyfin is PINNED to the v12.0.0 build in docker-compose.yml - hotio tags
# this image only `latest`/`release`, which silently rolled 11 -> 12 and
# crash-looped on a data migration. Uncomment to move off the pin deliberately.
# JELLYFIN_IMAGE=ghcr.io/hotio/jellyfin@sha256:6f9599ab620b7c3414a1de42120dc08e7984baeaf6094125ce5c99b39878046a
SABNZBD_PORT=8085
# Live TV — M3U + EPG guide URLs
LIVETV_M3U_URL=
LIVETV_GUIDE_URL=

# ── AI / recommendations ────────────────────────────────────────────────────
# OmniRoute-compatible endpoint (single provider pool) or a direct OpenAI URL.
# The platform's one gateway runs in Group 2 (`2-voice/`), on the gateway host
# 192.168.1.46 — not on this media host — so this is the SSO proxy in front of it
# (:20129, which exempts /v1 for API clients). The gateway's own :20128 answers on
# its host's loopback and bridge alone, and a `127.0.0.1` here would be the
# consumer itself (monarch-recs is a container; so is anything else that reads it).
OPENAI_BASE_URL=http://192.168.1.46:20129/v1
OPENAI_API_KEY=change-me-omniroute-api-key
OPENAI_MODEL=auto

# ── Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ─────────────
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by the Monarch media login.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us
# Cerulean's DNS plane is Technitium over HTTP (no TSIG/nsupdate). Monarch
# writes its A records through it: a new subdomain gets a record, a name that
# already resolves is left as is. A static token wins; else user/password.
TECHNITIUM_URL=http://192.168.1.46:5380
TECHNITIUM_TOKEN=
# TECHNITIUM_USER=admin
# TECHNITIUM_PASSWORD=

# ── Nginx Proxy Manager (the edge: proxy hosts, TLS, the admin UI) ──────────
# NPM_BASE_URL is the NPM API the reconcile script talks to.
NPM_BASE_URL=http://192.168.1.46:81
NPM_ADMIN_EMAIL=admin@innotel.us
NPM_ADMIN_PASSWORD=change-me
# This Docker host's IP (or "container" when NPM runs here and can resolve
# compose service names). Every proxy host forwards here.
NPM_FORWARD_HOST=192.168.1.56
# The NPM host itself. The edge (with its admin UI on :81) runs on this
# host beside Cerulean, so admin.<MONARCH_DOMAIN> forwards to NPM_HOST_IP:81
# here. The forward-auth gate lives on the same edge.
NPM_HOST_IP=192.168.1.46
NPM_MODE=remote
# Shared services that are NOT part of this stack and so must name their
# upstream explicitly in scripts/npm-hosts.conf. Both live on the trust host
# (Cerulean's): Authentik IS the identity provider — following NPM_FORWARD_HOST
# would point this domain's sign-in at a machine with no Authentik, breaking it
# — and the subscribe portal serves every domain from the same nginx on :3040.
AUTHENTIK_UPSTREAM_HOST=192.168.1.46
SUBSCRIBE_UPSTREAM_HOST=192.168.1.46

# ── Cerulean Vault (SecretOps) ───────────────────────────────────────────────────
# Values live in Cerulean Vault (HashiCorp Vault, KV v2, hosted by Cerulean), and
# this file may name one with a `vault://<mount>/<path>#<key>` reference:
#
#   MONARCH_PASSWORD=vault://cerulean/monarch#MONARCH_PASSWORD
#
# Nothing in this stack resolves a reference at runtime, so .env must hold the
# resolved value — a reference left in place reaches the container as a literal
# string. Move plaintext secrets in with scripts/vault-migrate.py, and check for
# leftovers with scripts/drift-check.sh. The full contract is in .env.sample.
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/monarch.token
VAULT_PREFIX=cerulean
VAULT_PATH=monarch
VAULT_TOKEN=

# ── Magnate billing (RevenueOps — optional paid media seats) ────────────────
# Magnate owns billing and the entitlement decision.
#   GET <MAGNATE_URL>/api/entitlements?plan=<slug>&user=<username|email>
#   → {"entitled": bool, "reason", "plan", "slug", "status", "expires_at"}
# scripts/magnate-entitlements.py turns that decision into Jellyfin policies
# (see scripts/magnate-tiers.json) and monarch-drift-check re-verifies it.
# MAGNATE_URL=https://magnate.innotel.us
# ENTITLEMENTS_API_TOKEN=  # must equal Magnate's ENTITLEMENTS_API_TOKEN
# MAGNATE_ENTITLEMENTS_PLAN=premium   # the plan slug Monarch's seats ride on
# The portal landing page and subscribing page: every "Subscribe" link in the
# stack points here, and Monarch hosts no pricing page or payment path.
SUBSCRIBE_URL=https://subscribe.innotel.us

# ── SSO gateways (oauth2-proxy) — media apps ────────────────────────────────
# One OIDC client (`monarch-media`) shared by every gateway; one sign-in covers
# them all because the cookie secret is the same one the NPM edge uses, on the
# same .innotel.us domain. Read by the `x-sso-env` block in docker-compose.yml,
# which every `*-sso` service inherits.
MONARCH_SSO_AUTHENTIK_BASE=https://auth.cerulean.innotel.us
MONARCH_SSO_APP=monarch-media
MONARCH_SSO_CLIENT_ID=monarch-media
MONARCH_SSO_CLIENT_SECRET=change-me-oidc-client-secret
# Every public name a gateway completes a sign-in on, comma-separated. These are
# the provider's redirect URIs, and the list is load-bearing: oauth2-proxy
# derives `redirect_uri` from the request's Host, so a name that is missing both
# here and on the provider does not degrade — Authentik refuses it with
# `invalid_request: redirect_uri does not match` before any login form appears.
#
# A name is therefore a TWO-file change: this list, and the provider, which is
# Cerulean's to register (authentik-setup.py takes the list verbatim):
#
#   env "AUTHENTIK_MONARCH-MEDIA_REDIRECT_URI=$MONARCH_SSO_REDIRECT_URIS" \
#     python3 1-primary/cerulean/scripts/authentik-setup.py monarch-media
#
# (`env` rather than a shell assignment because the app-slug prefix keeps the
# hyphen: AUTHENTIK_MONARCH-MEDIA_* is a legal environment name but not a legal
# bash variable name.)
#
# The last two entries are not oauth2-proxy callbacks. They are Jellyfin's own
# OIDC sign-in (the SSO button on its login page — `jellyfin-sso` no longer
# gates that page, see docker-compose.yml), which is a client of the same
# `monarch-media` provider. They belong in this list for the same reason every
# other name does: a provider refresh takes the list verbatim, and a list
# without them silently drops the one sign-in the Jellyfin login page offers.
# `scripts/jellyfin-oidc-sso.py` is what checks both halves.
MONARCH_SSO_REDIRECT_URIS=https://radarr.monarch.innotel.us/oauth2/callback,https://sonarr.monarch.innotel.us/oauth2/callback,https://lidarr.monarch.innotel.us/oauth2/callback,https://whisparr.monarch.innotel.us/oauth2/callback,https://bazarr.monarch.innotel.us/oauth2/callback,https://prowlarr.monarch.innotel.us/oauth2/callback,https://qbittorrent.monarch.innotel.us/oauth2/callback,https://sabnzbd.monarch.innotel.us/oauth2/callback,https://jellyseerr.monarch.innotel.us/oauth2/callback,https://req.monarch.innotel.us/oauth2/callback,https://req.innotel.us/oauth2/callback,https://media.innotel.us/oauth2/callback,https://media.magnate.innotel.us/oauth2/callback,https://tube.innotel.us/oauth2/callback,https://tv.monarch.innotel.us/oauth2/callback,https://requestrr.monarch.innotel.us/oauth2/callback,https://media.innotel.us/sso/OIDC/Callback/authentik,https://media.magnate.innotel.us/sso/OIDC/Callback/authentik
SSO_COOKIE_SECRET=change-me-same-secret-as-the-edge
SSO_COOKIE_DOMAIN=.innotel.us
SSO_REQUIRED_GROUP=cerulean-platform
# ── end SSO gateways ────────────────────────────────────────────────────────

# Shared oauth2-proxy session store (cerulean-sso-sessions on the platform edge
# host). Cookie sessions overflow the edge's proxy_buffer_size and 502 the
# callback, so every gateway keeps its session here instead.
# The store is NOT on this host: the media stack was split onto a server of its
# own and the store stayed on the edge host, so this is that host's LAN address
# — the one the store is published on precisely so a stack on another server can
# reach it. Its docker0 gateway is the right answer only on the edge host itself.
# The password is the whole control on that listener, which is why it cannot be
# empty. A wrong host does not degrade: every gateway exits on
# "dial tcp <host>:16380: connect: connection refused".
SSO_SESSION_REDIS_PASSWORD=
SSO_SESSION_REDIS_HOST=192.168.1.46
SSO_SESSION_REDIS_PORT=16380
