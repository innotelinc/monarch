# Monarch core — copy to .env and edit. Every value has a working default in
# the compose file except the SSO client, which must come from Cerulean.

# Where the service keeps its database and where the library lives.
CORE_DATA=/docker/appdata/core
MEDIA_ROOT=/data/media
DOWNLOADS_ROOT=/data/downloads
CORE_PORT=8090

# The one sign-in. Create the OIDC client in Cerulean Authentik and put the
# values here; OIDC_COOKIE_SECRET must be a 32-byte random string.
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/monarch/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECRET=
SSO_PORT=4180

# Transmission (the only download client the platform keeps).
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
TRANSMISSION_CONFIG=/docker/appdata/transmission

# Live TV: a playlist and a guide URL. Leave empty to hide the Live TV view.
LIVETV_M3U_URL=
LIVETV_XMLTV_URL=
LIVETV_CHANNEL_BASE=2

# Scheduler: how often to search, and how many requests per pass.
CORE_SEARCH_INTERVAL=900
CORE_SEARCH_BATCH=4

# Subtitles (what Bazarr used to do). A free OpenSubtitles.com API key covers a
# household; the account pair is optional and raises the daily quota.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# auto uses the .com API when a key is set and the keyless legacy service
# otherwise; opensubtitles/legacy force one of them.
CORE_SUBTITLE_PROVIDER=auto
CORE_SUBTITLE_LANGS=en
CORE_SUBTITLE_INTERVAL=21600
CORE_SUBTITLE_BATCH=15
CORE_SUBTITLE_DELAY=2

# Jellyfin: told about every import so new files appear without a manual scan.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Only for local development without the SSO gateway.
CORE_AUTH_DISABLED=0
