[TEMPLATE]
# ---------------------------------------------------------------------------
# Monarch Media Platform environment template
# Copy to .env and fill in:  cp .env.sample .env
# (.env is gitignored - your credentials never get committed)
# ---------------------------------------------------------------------------

# Shared initial credentials - used for EVERY service that requires a login:
# Jellyfin, Sonarr/Radarr/Lidarr/Whisparr, Prowlarr, Jellyseerr, qBittorrent,
# Bazarr, Transmission, Authentik bootstrap, subscription platform admin.
# monarch-seed + monarch-init apply these automatically on first boot.
MONARCH_USERNAME=admin
MONARCH_PASSWORD=change-me

# Timezone used by all containers
TZ=America/New_York

# ---------------------------------------------------------------------------
# Domain + subdomains (Nginx Proxy Manager auto-provisioning)
#
# setup.sh hands these to scripts/npm-proxy-hosts.py, which configures Nginx
# Proxy Manager through its API: it creates proxy hosts for the subdomains
# below, requests a wildcard certificate for *.MONARCH_DOMAIN via the DNS
# provider of your choice, and forces HTTPS. See the README for the default
# subdomain -> service map.
# ---------------------------------------------------------------------------

# Primary domain. Default subdomains are derived from it:
#   app  -> Homarr dashboard   (websockets)
#   api  -> billing-api
#   auth -> Authentik
#   media-> Jellyfin           (websockets)
#   tv   -> IPTV guide (XMLTV)
#   admin-> Nginx Proxy Manager admin UI
#   subscribe -> subscription landing page (Stripe)
#   req  -> Jellyseerr         (websockets)
MONARCH_DOMAIN=monarch.innotel.us

# Email used for Let's Encrypt (wildcard certificate notifications/renewals)
SSL_EMAIL=admin@innotel.us

# Nginx Proxy Manager admin login used by npm-proxy-hosts.py (created on the
# first visit to the NPM admin UI if it does not exist yet).
NPM_ADMIN_EMAIL=admin@innotel.us
NPM_ADMIN_PASSWORD=change-me

# DNS challenge provider for the wildcard certificate. Supported values:
# cloudflare (default), route53, digitalocean, godaddy, cloudxns, duckdns,
# vultr, dnsmadeeasy, linode, ovh, hetzner, acmedns, rfc2136.
# Provide the provider's credentials as a JSON object in NPM_DNS_CREDENTIALS
# (for Cloudflare the key is "auth_token").
NPM_DNS_PROVIDER=cloudflare
# NPM_DNS_CREDENTIALS={"auth_token":"your-cloudflare-api-token"}
# Convenience: if NPM_DNS_CREDENTIALS is empty and the provider is cloudflare,
# the token below is used automatically.
# CLOUDFLARE_API_TOKEN=

# Forward target used by the proxy hosts. "container" (default) forwards to
# each service's container name on the compose network; use
# "host.docker.internal" to forward to the host-published ports instead.
NPM_FORWARD_HOST=container

# ---------------------------------------------------------------------------
# Jellyfin Subscription Platform (https://github.com/innotelinc/jellyfin-subscription-platform)
# ---------------------------------------------------------------------------

# Public URL of the signup site (used in Stripe Checkout redirects).
# Point your reverse proxy at it, e.g. https://subscribe.monarch.innotel.us
APP_URL=https://subscribe.monarch.innotel.us

# Stripe - fill these in or the platform's config check will complain.
# STRIPE_WEBHOOK_SECRET comes from the FIRST webhook endpoint created in the
# Stripe dashboard (Developers > Webhooks > Add endpoint, URL: https://YOUR-DOMAIN/api/webhook)
# BILLING_WEBHOOK_SECRET comes from the SECOND endpoint pointing at billing-api
# (URL: http://<host>:8001/api/webhook) - it provisions the Authentik paid_users
# group. You may reuse STRIPE_WEBHOOK_SECRET for both.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Jellyfin connection. JELLYFIN_API_KEY is exported automatically on first
# boot by monarch-init to /docker/appdata/init/jellyfin-api-key.txt - copy the
# contents here, then:  sudo docker compose up -d
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Authentik - the platform creates/sets the subscriber's password here
# (Authentik-first: Jellyfin logins authenticate via the LDAP outpost).
# AUTHENTIK_BOOTSTRAP_TOKEN defaults to the same internal token billing-api
# uses; only set these if you changed the compose defaults.
AUTHENTIK_BASE_URL=http://authentik-server:9000
AUTHENTIK_BOOTSTRAP_TOKEN=ak-bootstrap-innotel-2026

# Account portal link shown to users: Authentik's self-service user settings
# (password resets). Defaults to AUTHENTIK_BASE_URL/if/user/ - only set this
# to override it (e.g. a public https URL behind your reverse proxy).
ACCOUNT_PORTAL_URL=https://auth.monarch.innotel.us/if/user/
REQUEST_URL=https://req.monarch.innotel.us

# Jellyfin logins authenticate against the Authentik LDAP outpost (LDAP-Auth
# plugin). All AUTHENTIK_LDAP_* values are internal defaults hardcoded in
# docker-compose.yml (billing-api provisions, monarch-init writes the Jellyfin
# plugin config) - see README "Authentik LDAP -> Jellyfin". No .env entries
# are needed unless you override the compose defaults.

# ---------------------------------------------------------------------------
# AI recommendations & smart search (monarch-recs)
#
# Content-based recommendations and search are fully local. To additionally
# enable LLM-generated descriptions ("AI") for items, set the endpoint
# settings below - any OpenAI-compatible API works (OpenAI, local llama.cpp,
# Ollama, vLLM, ...).
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Live TV - Jellyfin ingests the playlist directly (native M3U tuner, added
# by monarch-init) and uses the XMLTV guide from the iptv EPG container. The
# defaults below only need changing if you want a different/custom channel
# source - e.g. point LIVETV_M3U_URL at your own IPTV provider's playlist.
LIVETV_M3U_URL=https://iptv-org.github.io/iptv/countries/us.m3u
LIVETV_GUIDE_URL=http://iptv:3000/guide.xml

# Session-signing secret for the subscription platform. Generate one:
#   openssl rand -hex 32
SESSION_SECRET=change-me